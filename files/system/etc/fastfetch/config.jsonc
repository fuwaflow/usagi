{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/etc/fastfetch/bunny.txt",
    "type": "file",
    "padding": {
      "top": 2,
      "left": 2,
      "right": 4
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "de",
    "terminal",
    "cpu",
    "memory",
    "battery",
    "break",
    "colors"
  ]
}
